# Postgres connection string for the helpdesk database.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/helpdesk"

# Better Auth: secret used to sign session cookies/tokens. Generate one with
# `openssl rand -base64 32`. Required in production.
BETTER_AUTH_SECRET=""
# Base URL the auth server is reached at.
BETTER_AUTH_URL="http://localhost:3000"

# Account created by `bun run db:seed`. SEED_USER_ROLE is "admin" or "agent".
SEED_USER_EMAIL="admin@example.com"
SEED_USER_PASSWORD="password123"
SEED_USER_NAME="Admin"
SEED_USER_ROLE="admin"
